<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:include filename="$(find fanuc_resources)/urdf/common_materials.xacro"/>

  <xacro:macro name="fanuc_m20id25" params="prefix">
    <link name="${prefix}base_link">
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh filename="package://fanuc_m20id_support/meshes/m20id25/visual/base_link.stl"/>
      </geometry>
      <xacro:material_fanuc_gray28 />
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh filename="package://fanuc_m20id_support/meshes/m20id25/collision/base_link.stl"/>
      </geometry>
    </collision>
    </link>
    <link name="${prefix}link_1">
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="package://fanuc_m20id_support/meshes/m20id25/visual/link_1.stl"/>
        </geometry>
        <xacro:material_fanuc_yellow />
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="package://fanuc_m20id_support/meshes/m20id25/collision/link_1.stl"/>
        </geometry>
      </collision>
    </link>
    <link name="${prefix}link_2">
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="package://fanuc_m20id_support/meshes/m20id25/visual/link_2.stl"/>
        </geometry>
        <xacro:material_fanuc_yellow />
      </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh filename="package://fanuc_m20id_support/meshes/m20id25/visual/link_2.stl"/>
      </geometry>
    </collision>
    </link>
    <link name="${prefix}link_3">
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh filename="package://fanuc_m20id_support/meshes/m20id25/visual/link_3.stl"/>
      </geometry>
      <xacro:material_fanuc_yellow />
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh filename="package://fanuc_m20id_support/meshes/m20id25/collision/link_3.stl"/>
      </geometry>
    </collision>
    </link>
    <link name="${prefix}link_4">
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh filename="package://fanuc_m20id_support/meshes/m20id25/visual/link_4.stl"/>
      </geometry>
      <xacro:material_fanuc_yellow />
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh filename="package://fanuc_m20id_support/meshes/m20id25/collision/link_4.stl"/>
      </geometry>
    </collision>
    </link>
    <link name="${prefix}link_5">
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh filename="package://fanuc_m20id_support/meshes/m20id25/visual/link_5.stl"/>
      </geometry>
      <xacro:material_fanuc_yellow />
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh filename="package://fanuc_m20id_support/meshes/m20id25/collision/link_5.stl"/>
      </geometry>
    </collision>
    </link>
    <link name="${prefix}link_6">
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh filename="package://fanuc_m20id_support/meshes/m20id25/visual/link_6.stl"/>
      </geometry>
      <xacro:material_fanuc_yellow />
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh filename="package://fanuc_m20id_support/meshes/m20id25/collision/link_6.stl"/>
      </geometry>
    </collision>
    </link>

    <!-- ROS-Industrial 'base' frame: base_link to Fanuc World Coordinates transform -->
    <link name="${prefix}base" />
    <joint name="${prefix}base_link-base" type="fixed">
      <origin xyz="0 0 0.425" rpy="0 0 0"/>
      <parent link="${prefix}base_link"/>
      <child link="${prefix}base"/>
    </joint>

    <joint name="${prefix}joint_1" type="revolute">
      <origin
        xyz="0 0 0.425"
        rpy="0 0 0.0" />
      <parent link="${prefix}base_link"/>
      <child link="${prefix}link_1"/>
      <axis
        xyz="0 0 1" />
      <limit lower="${radians(-185)}" upper="${radians(185)}" effort="0" velocity="${radians(210)}" />

    </joint>

    <joint name="${prefix}joint_2" type="revolute">
      <origin
        xyz="0.075 0 0"
        rpy="0 0 0" />
      <parent link="${prefix}link_1"/>
      <child link="${prefix}link_2"/>
      <axis
        xyz="0 1 0" />
      <limit lower="${radians(-100)}" upper="${radians(160)}" effort="0" velocity="${radians(210)}" />
    </joint>

    <joint name="${prefix}joint_3" type="revolute">
      <origin
        xyz="0 0 0.84"
        rpy="0 0 0" />
      <parent link="${prefix}link_2"/>
      <child link="${prefix}link_3"/>
      <axis
        xyz="0 -1 0" />
      <limit lower="${radians(-190)}" upper="${radians(268)}" effort="0" velocity="${radians(265)}" />
    </joint>

    <joint name="${prefix}joint_4" type="revolute">
      <origin
        xyz="0 0 0.215"
        rpy="0 0 0" />
      <parent link="${prefix}link_3"/>
      <child link="${prefix}link_4"/>
      <axis
        xyz="-1 0 0" />
      <limit lower="${radians(-200)}" upper="${radians(200)}" effort="0" velocity="${radians(420)}" />
    </joint>

    <joint name="${prefix}joint_5" type="revolute">
      <origin
        xyz="0.89 0 0"
        rpy="0 0 0" />
      <parent link="${prefix}link_4"/>
      <child link="${prefix}link_5"/>
      <axis
        xyz="0 -1 0" />
      <limit lower="${radians(-180)}" upper="${radians(180)}" effort="0" velocity="${radians(420)}" />
    </joint>

    <joint name="${prefix}joint_6" type="revolute">
      <origin
        xyz="0.09 0 0"
        rpy="0 0 0" />
      <parent link="${prefix}link_5"/>
      <child link="${prefix}link_6"/>
      <axis
        xyz="-1 0 0" />
      <limit lower="${radians(-270)}" upper="${radians(270)}" effort="0" velocity="${radians(880)}" />
    </joint>

    <!-- ROS-Industrial 'flange' frame: attachment point for EEF models -->
    <link name="${prefix}flange" />
    <joint name="${prefix}joint_6-flange" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <parent link="${prefix}link_6" />
      <child link="${prefix}flange" />
    </joint>

    <!-- ROS-Industrial 'tool0' frame: all-zeros tool frame -->
    <link name="${prefix}tool0" />
    <joint name="${prefix}link_6-tool0" type="fixed">
      <origin xyz="0 0 0" rpy="${pi} ${-pi/2.0} 0" />
      <parent link="${prefix}flange" />
      <child link="${prefix}tool0" />
    </joint>
  </xacro:macro>
</robot>
